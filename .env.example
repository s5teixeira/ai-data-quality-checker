# Copy this file to .env and replace the placeholder with your own key.
# The .env file is ignored by git. The app works without a key; only the
# "Generate AI Insights" button needs it. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-3.5-flash-lite (a free-tier model) if left blank.
GEMINI_MODEL=gemini-3.5-flash-lite
